    "mail:check": "node tools/email/checkAccountMail.mjs",
    "mail:preview": "node tools/email/previewAccountMail.mjs",
    "contracts:import": "node tools/maintenance/importContractZipToDb.mjs",
    "contracts:scan": "node tools/maintenance/scanContractTemplates.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
