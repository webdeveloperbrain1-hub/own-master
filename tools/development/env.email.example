# Put these values into your existing private .env once a sender is available.
# Keep other settings (especially DATABASE_URL) intact. Never commit real secrets.
# SMTP delivery sends real mail, including to Gmail recipient inboxes.
EMAIL_DELIVERY_MODE=smtp
APP_ORIGIN=http://127.0.0.1:5174
SMTP_HOST=smtp.your-email-provider.example
SMTP_PORT=587
SMTP_FROM=Own Masters <no-reply@your-own-masters-domain.example>
SMTP_USER=your-provider-smtp-username
SMTP_PASSWORD=your-provider-smtp-password
