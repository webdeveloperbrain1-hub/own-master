DATABASE_URL=postgresql://ownmasters:ownmasters_password@localhost:5432/ownmasters_local
API_PORT=8787
API_HOST=127.0.0.1
# Only set this to your actual reverse proxy socket IPs when deploying.
AUTH_TRUSTED_PROXY_IPS=
CORS_ORIGIN=http://127.0.0.1:5174
# Leave empty when /api is served through the website's reverse proxy.
VITE_API_BASE_URL=
AI_PROVIDER=openai
AI_FEATURES_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTRACT_STORAGE_ROOT=./storage
# Optional library override. The bundled library loads automatically when empty
# or when the override archive is unavailable.
CONTRACT_ZIP_PATH=
CONTRACT_ZIP_DIR=./storage/contract-zips
CONTRACT_TEMPLATE_DIR=./storage/contract-templates
GENERATED_CONTRACT_DIR=./storage/generated-contracts
TMP_DIR=./storage/tmp
# Required for Word/RTF template layout and formatted DOCX/PDF exports.
# Leave empty to detect a standard LibreOffice installation.
LIBREOFFICE_PATH=

# Confirmation and password recovery emails. Required for production signup.
# Server-side only; no VITE_ prefix. See docs/auth-deployment.md.
# APP_ORIGIN must be the trusted website URL, never a URL supplied by a visitor.
# smtp delivers through your email provider. preview is development-only Mailpit.
EMAIL_DELIVERY_MODE=smtp
APP_ORIGIN=http://127.0.0.1:5174
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
BUSINESS_NAME=Own Masters
SUPPORT_EMAIL=admin@teddbernard.com

# Billing stays in preview until the account owner supplies Stripe settings.
# Preview never creates payments and does not restrict current exports.
# See docs/stripe-billing.md. All these settings are server-side only.
BILLING_MODE=preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
