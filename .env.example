# Copy these settings into the deployment host's secret/environment settings.
# Replace all example values. Keep the real DATABASE_URL and SMTP_PASSWORD private.
NODE_ENV=production
BUSINESS_NAME=Own Masters
SUPPORT_EMAIL=admin@teddbernard.com
APP_ORIGIN=https://your-domain.example
CORS_ORIGIN=https://your-domain.example
# Build the frontend with this empty, and reverse proxy /api to the Node API.
VITE_API_BASE_URL=
API_PORT=8787
AI_FEATURES_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# A same-machine reverse proxy connects over loopback. Containers/platforms may
# require 0.0.0.0; keep the API private behind the trusted HTTPS reverse proxy.
API_HOST=127.0.0.1
# Only list actual proxy socket IPs. Never use a visitor-supplied IP or hostname.
AUTH_TRUSTED_PROXY_IPS=
DATABASE_URL=postgresql://app_user:replace-with-a-unique-password@database-host:5432/ownmasters
CONTRACT_STORAGE_ROOT=/var/lib/ownmasters/storage
# filesystem uses a persistent disk. supabase uses this directory as a cache.
FILE_STORAGE_BACKEND=filesystem
# Server-only settings for the optional free cloud trial. Use a private bucket.
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=own-masters-private
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.your-email-provider.example
SMTP_PORT=587
SMTP_FROM=Own Masters <no-reply@your-domain.example>
SMTP_USER=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-secret

# Initial launch provides free access. Keep preview until paid plans are activated.
# Switch to stripe only when all three Stripe values have been configured.
BILLING_MODE=preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
