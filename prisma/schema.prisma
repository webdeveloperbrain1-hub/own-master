generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  emailVerifiedAt DateTime?
  role         String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AccountSession[]
  resetTokens  PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  contracts    AccountContract[]
  billing      BillingAccount?
}

model BillingAccount {
  userId                 String      @id
  user                   AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId       String?     @unique
  stripeSubscriptionId   String?     @unique
  stripePriceId          String?
  subscriptionStatus     String      @default("none")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd       Boolean     @default(false)
  accessPaused           Boolean     @default(false)
  checkoutSessionId      String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model BillingWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  tokenHash String      @id
  userId    String      @unique
  user      AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  returnTo  String      @default("/dashboard")
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([expiresAt])
}

model AccountSession {
  tokenHash String      @id
  userId    String
  user      AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String      @id
  userId    String
  user      AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([userId])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AccountContract {
  id                         String      @id @default(cuid())
  userId                     String
  user                       AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                      String
  contractType               String
  status                     String      @default("draft")
  content                    String
  userRequest                String?
  selectedTemplateId         String?
  selectedTemplateSourceFile String?
  wizardAnswers              Json        @default("{}")
  aiRecommendation           Json?
  aiRiskReview               Json?
  aiSummary                  String?
  riskFlags                  Json        @default("[]")
  lastAiReviewedAt            DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([userId, updatedAt])
}

enum ContractFileType {
  doc
  docx
  pdf
  rtf
  txt
}

enum AIScanStatus {
  not_scanned
  scanning
  scanned
  needs_review
  failed
}

model ContractTemplate {
  id                 String           @id @default(cuid())
  name               String
  category           String?
  originalFileName   String
  fileType           ContractFileType
  storagePath        String

  sourceZipPath      String?
  fileHash           String?

  extractedText      String?
  textQuality        String?

  aiScanStatus       AIScanStatus     @default(not_scanned)
  fieldSchema        Json?
  warnings           Json?
  scanError          String?
  approved           Boolean          @default(false)

  generatedContracts GeneratedContract[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([fileHash])
  @@index([aiScanStatus])
  @@index([fileType])
  @@index([name])
}

model GeneratedContract {
  id                    String           @id @default(cuid())
  userId                String?
  templateId            String
  template              ContractTemplate @relation(fields: [templateId], references: [id])
  title                 String?
  dealData              Json
  outputDocxPath        String
  outputPdfPath         String?
  missingRequiredFields Json?
  warnings              Json?
  createdAt             DateTime         @default(now())

  @@index([templateId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Contract Filing engine (ported from the standalone "contract filing" app).
// Source of truth for the new in-site contract filler. Independent of the
// legacy ContractTemplate/GeneratedContract models above.
// ---------------------------------------------------------------------------

model ContractFile {
  id                 String   @id @default(cuid())
  originalName       String
  originalPath       String
  storedPath         String
  extension          String
  sizeBytes          Int
  sha256             String   @unique
  textLength         Int      @default(0)
  extractedText      String?
  extractionStatus   String   @default("pending")
  extractionWarnings String[] @default([])
  analysisStatus     String   @default("pending")
  needsReview        Boolean  @default(false)
  reviewReason       String?
  title              String?
  contractType       String?
  category           String?
  parties            Json?
  effectiveDate      String?
  expirationDate     String?
  summary            String?
  keyTerms           Json?
  obligations        Json?
  rights             Json?
  paymentTerms       String?
  territory          String?
  duration           String?
  governingLaw       String?
  renewalTerms       String?
  terminationTerms   String?
  riskFlags          Json?
  tags               String[] @default([])
  confidence         Float?
  analyzerModel      String?
  importedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  drafts             ContractDraft[]
  fieldScan          ContractTemplateFieldScan?

  @@index([contractType])
  @@index([category])
  @@index([needsReview])
  @@index([analysisStatus])
}

model ContractTemplateFieldScan {
  id            String       @id @default(cuid())
  templateId    String       @unique
  template      ContractFile @relation(fields: [templateId], references: [id], onDelete: Cascade)
  status        String       @default("pending")
  analyzerModel String?
  fields        Json
  warnings      String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
}

model ContractDraft {
  id           String       @id @default(cuid())
  userId       String
  templateId   String
  template     ContractFile @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  values       Json
  renderedText String
  status       String       @default("draft")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projectLinks ProjectContract[]
  progress     ContractProgress?

  @@index([userId])
  @@index([templateId])
  @@index([status])
}

model MusicProject {
  id          String   @id @default(cuid())
  userId      String
  title       String
  lyrics      String   @default("")
  fileName    String?
  fileSize    Int      @default(0)
  audioType   String?
  audioPath   String?
  legacyId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    ProjectComment[]
  contracts   ProjectContract[]

  @@unique([userId, legacyId])
  @@index([userId, updatedAt])
}

model ProjectComment {
  id        String       @id @default(cuid())
  projectId String
  project   MusicProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime     @default(now())
}

model ProjectContract {
  id                String         @id @default(cuid())
  projectId         String
  project           MusicProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draftId           String?
  draft             ContractDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)
  accountContractId String?
  title             String
  contractType      String
  createdAt         DateTime       @default(now())

  @@unique([projectId, draftId])
  @@unique([projectId, accountContractId])
}

enum ContractProgressStage {
  draft
  ready_for_review
  awaiting_signatures
  signed
  cancelled
}

model ContractProgress {
  id                String                @id @default(cuid())
  userId            String
  draftId           String?               @unique
  draft             ContractDraft?        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  accountContractId String?
  status            ContractProgressStage @default(draft)
  version           Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  events            ContractProgressEvent[]
  signedCopies      SignedContractCopy[]

  @@unique([userId, accountContractId])
  @@index([userId, updatedAt])
}

model ContractProgressEvent {
  id         String                @id @default(cuid())
  progressId String
  progress   ContractProgress      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  action     String
  fromStatus ContractProgressStage?
  toStatus   ContractProgressStage
  actorId    String
  actorName  String
  note       String                @default("")
  createdAt  DateTime              @default(now())

  @@index([progressId, createdAt])
}

model SignedContractCopy {
  id         String           @id @default(cuid())
  progressId String
  progress   ContractProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  fileName   String
  storedPath String
  sizeBytes  Int
  uploadedAt DateTime         @default(now())

  @@index([progressId, uploadedAt])
}
